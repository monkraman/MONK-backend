# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (local MongoDB or MongoDB Atlas URI)
MONGO_URI=mongodb://127.0.0.1:27017/monktrace
MONGO_DB_NAME=monktrace

# JWT Configuration (Must be at least 32 characters)
JWT_SECRET=super_secret_jwt_key_with_at_least_32_characters_for_nhs_demo
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_chars_nhs_demo
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Security Configuration
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
AUTH_RATE_LIMIT_MAX=50

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Frontend URL for CORS (Support localhost and deployed Render URLs)
FRONTEND_URL=http://localhost:5173

# Demo mode: Disable open public self-registration
DISABLE_PUBLIC_REGISTRATION=true
